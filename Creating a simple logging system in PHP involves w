## 🛠️ Updated Logger with Cleanup + Context

### Features:

* **Log Cleanup**: Only keeps the last `X` days of logs (configurable).
* **Contextual Logging**: You can add additional context data (e.g., user\_id, IP address) to each log entry.

```php
<?php
class Logger {
    private string $logDir;
    private int $daysToKeep;

    public function __construct(string $logDir = 'logs', int $daysToKeep = 7) {
        $this->logDir = rtrim($logDir, '/');
        $this->daysToKeep = $daysToKeep;

        // Create the log directory if it doesn't exist
        if (!is_dir($this->logDir)) {
            mkdir($this->logDir, 0777, true);
        }

        // Clean up old log files
        $this->cleanOldLogs();
    }

    private function getLogFile(): string {
        $date = date('Y-m-d');
        return "{$this->logDir}/log-{$date}.json";
    }

    private function log(string $level, string $message, array $context = []): void {
        // Include timestamp and level
        $entry = [
            'timestamp' => date('Y-m-d H:i:s'),
            'level'     => strtoupper($level),
            'message'   => $message,
        ];

        // Add context (optional)
        if (!empty($context)) {
            $entry['context'] = $context;
        }

        $logLine = json_encode($entry, JSON_UNESCAPED_SLASHES) . PHP_EOL;
        file_put_contents($this->getLogFile(), $logLine, FILE_APPEND);
    }

    public function info(string $message, array $context = []): void {
        $this->log('info', $message, $context);
    }

    public function warning(string $message, array $context = []): void {
        $this->log('warning', $message, $context);
    }

    public function error(string $message, array $context = []): void {
        $this->log('error', $message, $context);
    }

    private function cleanOldLogs(): void {
        $files = glob("{$this->logDir}/log-*.json");

        foreach ($files as $file) {
            $fileDate = basename($file, '.json');
            $fileDate = substr($fileDate, 4); // Extract date from 'log-YYYY-MM-DD'

            // Check if the file is older than $daysToKeep
            if (strtotime($fileDate) < strtotime("-{$this->daysToKeep} days")) {
                unlink($file); // Delete the file
            }
        }
    }
}
```

